# Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dontwasteit?retryWrites=true&w=majority

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=your_jwt_secret_key_change_in_production

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# Optional: Google Gemini AI API Key (falls back to deterministic NLP if unconfigured)
GEMINI_API_KEY=your_gemini_api_key_optional
