# ==============================================================================
# Environment Configuration Template for "Don't Waste It" Production & Docker
# Copy this file to .env before running: cp .env.example .env
# ==============================================================================

# ----------------------------------------------------
# Global & Container Settings
# ----------------------------------------------------
NODE_ENV=production

# ----------------------------------------------------
# MongoDB Database Configuration
# ----------------------------------------------------
# For Docker Compose setup: mongodb service name is "mongodb"
MONGO_INITDB_DATABASE=dontwasteit
MONGODB_URI=mongodb://mongodb:27017/dontwasteit

# ----------------------------------------------------
# Backend API Configuration
# ----------------------------------------------------
PORT=5000
BACKEND_PORT=5000

# Secret key used for signing and verifying JSON Web Tokens (JWT)
# IMPORTANT: Generate a strong, random 256-bit string for production
JWT_SECRET=production_super_secret_jwt_key_dontwasteit_2026

# Allowed CORS Origin (Frontend URL or * for public access)
CORS_ORIGIN=http://localhost:80

# Optional: Google Gemini AI API Key (falls back to deterministic NLP parser if unconfigured)
GEMINI_API_KEY=your_gemini_api_key_optional

# ----------------------------------------------------
# Frontend Web Service Configuration
# ----------------------------------------------------
FRONTEND_PORT=80
VITE_API_URL=http://localhost:5000/api

